# Kopieren nach .env und anpassen: cp .env.example .env

# --- LLM-Provider: auto | anthropic | openai | ollama | none
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Embedding-Modell (nach einem Wechsel Index neu bauen + python -m core.calibrate)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Kosinus-Grenzwerte für die Prozentskala (Ergebnis von python -m core.calibrate)
COS_FLOOR=0.44
COS_CEIL=0.874

# --- Scoring
# Anteil der Programm-Zentroide am Score (Rest: Mittel der Top-k Chunks)
SCORE_ALPHA=0.5
SCORE_TOP_K_CHUNKS=5
PRIOR_WEIGHT=1.0
INTRO_WEIGHT=1.0

# --- Akinator-Loop
MAX_QUESTIONS=12
MIN_QUESTIONS=5
CANDIDATE_POOL=3
STOP_PERCENT=75
STOP_MARGIN=15

# --- Index
CHUNK_SIZE=500
CHUNK_OVERLAP=80
CHROMA_DIR=.chroma
DATA_DIR=data
